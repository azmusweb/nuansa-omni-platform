{
  "name": "nuansa-omni-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Nuansa Network Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run deploy --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
